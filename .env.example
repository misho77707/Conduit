# Copy to .env and edit. Never commit .env.

# REQUIRED. Master key that encrypts saved database credentials. Lose it and saved passwords are unreadable.
# Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONDUIT_SECRET_KEY=

# The first account, a superadmin, created on first start (only while there are no users at all; later, manage
# users in Control & Setup > Users). Leave the password empty to have a temporary one generated and printed once in the
# api logs (docker compose logs api | grep "generated password"); you set your own at that first sign-in.
CONDUIT_ADMIN_USER=admin
CONDUIT_ADMIN_PASSWORD=

# App database password (the Postgres inside this compose file, not your data databases).
POSTGRES_PASSWORD=conduit

# Where the browser UI is served from (CORS).
CONDUIT_CORS_ORIGINS=http://localhost:5173

# The compose network has a fixed subnet so the frontend's nginx has a fixed address, the only one the API trusts
# X-Forwarded-For from (real client addresses for login throttling). Change all three together if the subnet
# clashes with another network on this host: CONDUIT_PROXY_IP inside CONDUIT_SUBNET, outside CONDUIT_SUBNET_DYNAMIC.
# CONDUIT_SUBNET=172.30.80.0/24
# CONDUIT_SUBNET_DYNAMIC=172.30.80.128/25
# CONDUIT_PROXY_IP=172.30.80.10

# Seconds between background connection health checks.
CONDUIT_HEALTH_CHECK_INTERVAL_S=30
CONDUIT_WORKER_CONCURRENCY=4

# Biggest request nginx accepts, so the most a browser upload can ever be (MB). Read by frontend and api at start.
# CONDUIT_UPLOAD_CEILING_MB=2048

# Alerts (Control & Setup). The address people open Conduit at: alert messages link to the right page (empty = no
# links). The instance name tells two Conduits apart in messages and exports. Both can also be set in Settings.
# CONDUIT_PUBLIC_URL=https://conduit.example.com
# CONDUIT_INSTANCE_NAME=Conduit

# Runtime settings: everything below (and the remote / combined limits further down) can also be changed in
# Control & Setup > Settings without a restart; a value saved there wins over .env. Defaults shown.
# CONDUIT_KEEP_FINISHED_JOBS=10        # finished jobs kept (no history)
# CONDUIT_KEEP_COMPARISONS=10          # finished comparisons kept
# CONDUIT_MAX_WORKERS_PER_JOB=32       # parallel splits one job may ask for
# CONDUIT_CONNECT_TIMEOUT_S=8          # opening a database connection
# CONDUIT_UPLOAD_MAX_MB=2048           # one browser upload (never above the ceiling)
# CONDUIT_MONITOR_WARN_PCT=85          # CPU / memory / disk "High" (and the host alert's default threshold)
# CONDUIT_CHECK_TIMEOUT_S=8            # HTTP / TCP / docker service checks
# CONDUIT_CONNECTION_SLOW_MS=500       # slower handshake: connection "degraded"
# CONDUIT_CHECK_SLOW_MS=2000           # slower answer: service check "warn"
# CONDUIT_ALERT_SEND_TIMEOUT_S=10      # one attempt to send an alert

# Remote intake (S3 / SFTP / URL files). Defaults shown; see README "Remote files".
# CONDUIT_REMOTE_MAX_FILE_MB=20480      # biggest remote file (or file unpacked from a .zip)
# CONDUIT_REMOTE_MAX_FILES=500          # files per "all matching files" run
# CONDUIT_REMOTE_INSPECT_FULL_MB=200    # previews download files whole up to this size; bigger ones are sampled
# CONDUIT_REMOTE_CACHE_MB=2048          # preview / unpacked-archive cache under data/remote/cache
# CONDUIT_REMOTE_TIMEOUT_S=60           # per request to a remote server
# CONDUIT_REMOTE_LIST_MAX=100000        # entries a pattern may scan under its folder

# Combined pipeline sources (several inputs joined by one SQL). Defaults shown; see README "Combined sources".
# CONDUIT_COMBINED_PREVIEW_ROWS=100000      # a preview reads at most this many rows per input
# CONDUIT_COMBINED_LOOKUP_MAX_ROWS=5000000  # stream mode: biggest lookup (every input but the driver), in rows ...
# CONDUIT_COMBINED_LOOKUP_MAX_MB=2048       # ... and in memory; bigger lookups need staged mode
# CONDUIT_COMBINED_MIN_FREE_GB=5            # staged mode stops staging below this much free space in the data folder ...
# CONDUIT_COMBINED_MIN_FREE_PCT=5           # ... or below this share of the disk, whichever is larger
# Behind a TLS-intercepting proxy: mount its root CA into api + worker and add these two to docker-compose.yml
# SSL_CERT_FILE=/certs/ca.pem
# AWS_CA_BUNDLE=/certs/ca.pem
