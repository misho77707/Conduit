# Copy to .env and edit. Never commit .env.

# REQUIRED. Master key that encrypts saved database credentials. Lose it and saved passwords are unreadable.
# Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONDUIT_SECRET_KEY=

# Admin login, created on first start. Leave the password empty to have one generated and printed once in
# the api logs:  docker compose logs api | grep "generated password"
CONDUIT_ADMIN_USER=admin
CONDUIT_ADMIN_PASSWORD=

# App database password (the Postgres inside this compose file, not your data databases).
POSTGRES_PASSWORD=conduit

# Where the browser UI is served from (CORS).
CONDUIT_CORS_ORIGINS=http://localhost:5173

# Seconds between background connection health checks.
CONDUIT_HEALTH_CHECK_INTERVAL_S=30
CONDUIT_WORKER_CONCURRENCY=4

# Remote intake (S3 / SFTP / URL files). Defaults shown; see README "Remote files".
# CONDUIT_REMOTE_MAX_FILE_MB=20480      # biggest remote file (or file unpacked from a .zip)
# CONDUIT_REMOTE_MAX_FILES=500          # files per "all matching files" run
# CONDUIT_REMOTE_INSPECT_FULL_MB=200    # previews download files whole up to this size; bigger ones are sampled
# CONDUIT_REMOTE_CACHE_MB=2048          # preview / unpacked-archive cache under data/remote/cache
# CONDUIT_REMOTE_TIMEOUT_S=60           # per request to a remote server
# CONDUIT_REMOTE_LIST_MAX=100000        # entries a pattern may scan under its folder
# Behind a TLS-intercepting proxy: mount its root CA into api + worker and add these two to docker-compose.yml
# SSL_CERT_FILE=/certs/ca.pem
# AWS_CA_BUNDLE=/certs/ca.pem
